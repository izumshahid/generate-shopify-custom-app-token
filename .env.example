# Shopify app credentials — copy this file to ".env" and fill in real values.
# ".env" is gitignored and must never be committed.

# From your Shopify Partner dashboard → your app → API credentials
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Comma-separated scopes the app requests
SCOPES=write_companies,read_customers,read_orders,read_products

# Local OAuth settings (defaults shown; usually no need to change)
REDIRECT_URI=http://localhost:3000/callback
PORT=3000
